{
  "name": "sennoric",
  "displayName": "Sennoric",
  "description": "AI coding agent — chat, edit files, run tools, right in VS Code",
  "version": "0.1.0",
  "publisher": "sennoric-labs",
  "icon": "icons/icon128.png",
  "repository": { "type": "git", "url": "https://github.com/SennoricLabsAI/sennoric" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["AI", "Chat", "Other"],
  "keywords": ["ai", "copilot", "coding", "agent", "fresco", "fresco"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sennoric-sidebar",
          "title": "Sennoric",
          "icon": "icons/icon-mono.svg"
        }
      ]
    },
    "views": {
      "sennoric-sidebar": [
        {
          "id": "sennoric.chat",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "sennoric.open",
        "title": "Open Sennoric",
        "category": "Sennoric"
      },
      {
        "command": "sennoric.sendSelection",
        "title": "Ask Sennoric about this",
        "category": "Sennoric"
      },
      {
        "command": "sennoric.addFile",
        "title": "Add file to Sennoric context",
        "category": "Sennoric"
      },
      {
        "command": "sennoric.newChat",
        "title": "New Chat",
        "category": "Sennoric"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sennoric.sendSelection",
          "when": "editorHasSelection",
          "group": "sennoric@1"
        },
        {
          "command": "sennoric.addFile",
          "group": "sennoric@2"
        }
      ],
      "view/title": [
        {
          "command": "sennoric.newChat",
          "when": "view == sennoric.chat",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sennoric.sendSelection",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Sennoric",
      "properties": {
        "sennoric.port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the Sennoric web server (sennoric-serve / sennoric --web)"
        }
      }
    }
  }
}
